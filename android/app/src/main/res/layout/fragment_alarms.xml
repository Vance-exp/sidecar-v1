<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- ── Section label ────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ALARMS"
            android:textColor="#FB6000"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:layout_marginBottom="12dp"/>

        <!-- ── ALARM 1 ────────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/llAlarm0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/alarm_card_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <!-- Header row: label + enable switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ALARM 1"
                    android:textColor="#FB6000"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAlarmEn0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <!-- Time display (tappable) -->
            <TextView
                android:id="@+id/tvAlarmTime0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:00"
                android:textColor="#FB6000"
                android:textSize="36sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Day-of-week toggles -->
            <LinearLayout
                android:id="@+id/llAlarmDays0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ToggleButton android:id="@+id/tgA0Sun" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="S" android:textOff="S" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA0Mon" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="M" android:textOff="M" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA0Tue" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="T" android:textOff="T" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA0Wed" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="W" android:textOff="W" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA0Thu" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="T" android:textOff="T" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA0Fri" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="F" android:textOff="F" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA0Sat" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="S" android:textOff="S" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ── ALARM 2 ────────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/llAlarm1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/alarm_card_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ALARM 2"
                    android:textColor="#FB6000"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAlarmEn1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvAlarmTime1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00"
                android:textColor="#FB6000"
                android:textSize="36sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:id="@+id/llAlarmDays1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ToggleButton android:id="@+id/tgA1Sun" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="S" android:textOff="S" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA1Mon" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="M" android:textOff="M" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA1Tue" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="T" android:textOff="T" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA1Wed" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="W" android:textOff="W" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA1Thu" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="T" android:textOff="T" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA1Fri" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="F" android:textOff="F" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA1Sat" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="S" android:textOff="S" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ── ALARM 3 ────────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/llAlarm2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/alarm_card_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ALARM 3"
                    android:textColor="#FB6000"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAlarmEn2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvAlarmTime2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:00"
                android:textColor="#FB6000"
                android:textSize="36sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:id="@+id/llAlarmDays2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ToggleButton android:id="@+id/tgA2Sun" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="S" android:textOff="S" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA2Mon" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="M" android:textOff="M" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA2Tue" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="T" android:textOff="T" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA2Wed" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="W" android:textOff="W" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA2Thu" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="T" android:textOff="T" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA2Fri" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="F" android:textOff="F" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>
                <ToggleButton android:id="@+id/tgA2Sat" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:textOn="S" android:textOff="S" android:textSize="11sp" android:fontFamily="monospace" android:background="@drawable/toggle_day_bg" android:textColor="@drawable/toggle_day_text" android:padding="2dp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
