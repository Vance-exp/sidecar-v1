<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BATTERY DIAGNOSTICS"
            android:textColor="#FB6000"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:layout_marginBottom="12dp"/>

        <!-- Live readings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvBattPct"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="---%"
                android:textColor="#FB6000"
                android:textSize="40sp"
                android:fontFamily="monospace"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvBattVolt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-.--- V"
                    android:textColor="#FFD700"
                    android:textSize="18sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tvBattMa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--.- mA"
                    android:textColor="#00BFFF"
                    android:textSize="14sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tvBattSampleCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 samples"
                    android:textColor="#4A4A4A"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Chart -->
        <com.sidecar.companion.BatteryChartView
            android:id="@+id/battChartView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="12dp"/>

        <!-- Stats -->
        <TextView
            android:id="@+id/tvBattStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No data yet"
            android:textColor="#7A7A7A"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.5"
            android:background="#0F0F0F"
            android:padding="10dp"
            android:layout_marginBottom="12dp"/>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnExportCsv"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="EXPORT CSV"
                android:textColor="#0A0A0A"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:backgroundTint="#FB6000"/>

            <Button
                android:id="@+id/btnClearSession"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="CLEAR"
                android:textColor="#FB6000"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:backgroundTint="#1E1E1E"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
