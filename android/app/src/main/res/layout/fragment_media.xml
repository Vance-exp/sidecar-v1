<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0A"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NOW PLAYING"
        android:textColor="#FB6000"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:layout_marginBottom="24dp"/>

    <!-- Playing indicator dot -->
    <TextView
        android:id="@+id/tvPlayingDot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="◉  PLAYING"
        android:textColor="#FB6000"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:layout_marginBottom="20dp"/>

    <!-- Song title -->
    <TextView
        android:id="@+id/tvSongTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="#FB6000"
        android:textSize="22sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="8dp"/>

    <!-- Artist -->
    <TextView
        android:id="@+id/tvArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="#7A6040"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="32dp"/>

    <!-- Volume row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOL"
            android:textColor="#4A4A4A"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="8dp"/>

        <android.widget.ProgressBar
            android:id="@+id/volumeBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="50"
            android:progressTint="#FB6000"
            android:progressBackgroundTint="#1E1E1E"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvVolPct"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="—%"
            android:textColor="#7A7A7A"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:gravity="end"/>

    </LinearLayout>

    <!-- Transport controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="⏮  PREV"
            android:textColor="#FB6000"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:backgroundTint="#1A1A1A"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="▶  PLAY"
            android:textColor="#0A0A0A"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:backgroundTint="#FB6000"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="NEXT  ⏭"
            android:textColor="#FB6000"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:backgroundTint="#1A1A1A"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

    </LinearLayout>

    <!-- Volume controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnVolDown"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="VOL —"
            android:textColor="#7A7A7A"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:backgroundTint="#111111"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnVolUp"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="VOL +"
            android:textColor="#7A7A7A"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:backgroundTint="#111111"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- No-session hint -->
    <TextView
        android:id="@+id/tvNoSession"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No active media session"
        android:textColor="#2A2A2A"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:visibility="gone"/>

</LinearLayout>
